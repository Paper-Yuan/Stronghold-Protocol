<?xml version="1.0" encoding="utf-8"?>
<!-- Connection chooser. Shown on the very first launch (before the WebView navigates) and again from
     the in-game gear. Three cards because those are the three things a player actually means; the
     board-quality block is a preference, not a first-run decision, so the code hides it on first run.
     Landscape gives ~360dp of height, hence the ScrollView and the tight paddings. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/switch_server_title"
            android:textColor="@color/theme_teal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9fb0a9"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardSolo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#131817"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <View
                    android:id="@+id/cardSoloStrip"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/border_gray" />

                <TextView
                    android:id="@+id/cardSoloTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="本机单人"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="手机自己开服，不连网也能玩。"
                    android:textColor="#9fb0a9"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardLan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#131817"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <View
                    android:id="@+id/cardLanStrip"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/border_gray" />

                <TextView
                    android:id="@+id/cardLanTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="同一 Wi-Fi"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="手机开服进大厅，朋友只填 4 位同盟密钥就能进来。UU 加速器 / Tailscale 这类虚拟局域网开服也选这个。"
                    android:textColor="#9fb0a9"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardRemote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#131817"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <View
                    android:id="@+id/cardRemoteStrip"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/border_gray" />

                <TextView
                    android:id="@+id/cardRemoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="填地址连接"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="加入别人开好的服务器：粘贴房主发来的地址或邀请链接。自己开服别选这个，填自己的地址会连不上。"
                    android:textColor="#9fb0a9"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLocalIpHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/theme_teal"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etServerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_dark"
            android:hint="@string/server_address_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="#60706a"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUrlPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/theme_teal"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/boardBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="战场棋盘渲染模式"
                android:textColor="@color/theme_teal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgBoardMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBoard3D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="3D 官方贴图 (高保真)"
                    android:textColor="@color/text_white" />

                <RadioButton
                    android:id="@+id/rbBoard2D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="2D 极速省电 (保帧稳 60fps)"
                    android:textColor="@color/text_white" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnFirstRunSolo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="先用本机单人"
                android:textColor="@color/text_white"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnShowLogsSwitch"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="诊断与日志"
                android:textColor="@color/theme_teal" />

            <Button
                android:id="@+id/btnCancelDialog"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_white" />

            <Button
                android:id="@+id/btnApplyDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/theme_teal"
                android:text="@string/btn_confirm"
                android:textColor="@color/bg_dark" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
