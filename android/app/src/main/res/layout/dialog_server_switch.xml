<?xml version="1.0" encoding="utf-8"?>
<!-- Connection chooser dialog with Arknights-style layout.
     Re-architected into a compact two-column landscape view so that the entire dialog
     fits comfortably within standard landscape heights (~360dp) without needing to scroll. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ark_dialog"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="@string/switch_server_title"
                        android:textColor="@color/theme_teal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDialogSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#9fb0a9"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnShowLogsSwitch"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="运行诊断与日志"
                    android:textColor="#789288"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#22312b" />

            <!-- Main Content: Two Columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Left Column: Mode Selection & Address / Hint -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1.15"
                    android:orientation="vertical">

                    <!-- Mode Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cardSolo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#131817"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <View
                                android:id="@+id/cardSoloStrip"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:background="@color/border_gray" />

                            <TextView
                                android:id="@+id/cardSoloTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="单人游玩"
                                android:textColor="@color/text_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="离线单机·内置引擎"
                                android:textColor="#859990"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardLan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#131817"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <View
                                android:id="@+id/cardLanStrip"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:background="@color/border_gray" />

                            <TextView
                                android:id="@+id/cardLanTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="开服做房主"
                                android:textColor="@color/text_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="手机开服·局域网联机"
                                android:textColor="#859990"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardRemote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#131817"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <View
                                android:id="@+id/cardRemoteStrip"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:background="@color/border_gray" />

                            <TextView
                                android:id="@+id/cardRemoteTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="去加朋友"
                                android:textColor="@color/text_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="加入远程服或朋友"
                                android:textColor="#859990"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Interactive Area below cards -->
                    <TextView
                        android:id="@+id/tvLocalIpHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/theme_teal"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etServerAddress"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_ark_input"
                        android:hint="@string/server_address_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:textColor="@color/text_white"
                        android:textColorHint="#50655d"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvUrlPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/theme_teal"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <!-- 备用服务器（业主 2026-10-20）：主地址连不上时点一下换成这个 -->
                    <TextView
                        android:id="@+id/tvBackupUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="1dp"
                        android:textColor="#50655d"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Right Column: Board Rendering & Display Options -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.85"
                    android:background="#0e1412"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:id="@+id/boardBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="战场棋盘渲染模式"
                            android:textColor="@color/theme_teal"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgBoardMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbBoard3D"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/theme_teal"
                                android:checked="true"
                                android:text="3D 官方贴图"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />

                            <RadioButton
                                android:id="@+id/rbBoard2D"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:buttonTint="@color/theme_teal"
                                android:text="2D 极速省电"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                        </RadioGroup>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swHighRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/high_refresh_toggle"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        app:switchPadding="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblEdge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/edge_padding_label"
                            android:textColor="#9fb0a9"
                            android:textSize="10sp" />

                        <SeekBar
                            android:id="@+id/sbEdge"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:max="200"
                            android:progressBackgroundTint="#22312b"
                            android:progressTint="@color/theme_teal"
                            android:thumbTint="@color/theme_teal" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#22312b" />

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFirstRunSolo"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="先用本机单人"
                    android:textColor="#789288"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCancelDialog"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnApplyDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/theme_teal"
                    android:minHeight="0dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/btn_confirm"
                    android:textColor="#09100d"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
