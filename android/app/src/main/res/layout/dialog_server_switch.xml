<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/switch_server_title"
        android:textColor="@color/theme_teal"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 运行模式设置 -->
    <RadioGroup
        android:id="@+id/rgServerMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rbLocalMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/local_mode"
            android:textColor="@color/text_white" />

        <TextView
            android:id="@+id/tvLocalIpHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/theme_teal"
            android:textSize="12sp"
            android:text="本机局域网地址: 正在获取…" />

        <RadioButton
            android:id="@+id/rbRemoteMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/remote_mode"
            android:textColor="@color/text_white" />
    </RadioGroup>

    <EditText
        android:id="@+id/etServerAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/bg_dark"
        android:hint="@string/server_address_hint"
        android:padding="10dp"
        android:textColor="@color/text_white"
        android:textColorHint="#60706a"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 渲染画质切换 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="战场棋盘渲染模式"
        android:textColor="@color/theme_teal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgBoardMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbBoard3D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="3D 官方贴图 (高保真)"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rbBoard2D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="2D 极速省电 (保帧稳 60fps)"
            android:textColor="@color/text_white" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShowLogsSwitch"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="诊断与日志"
            android:textColor="@color/theme_teal" />

        <Button
            android:id="@+id/btnCancelDialog"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnApplyDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/theme_teal"
            android:text="@string/btn_confirm"
            android:textColor="@color/bg_dark" />
    </LinearLayout>

</LinearLayout>
