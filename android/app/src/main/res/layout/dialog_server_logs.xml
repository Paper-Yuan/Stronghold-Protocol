<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="引擎状态诊断与运行日志"
        android:textColor="@color/theme_teal"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 诊断信息状态卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/bg_dark"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvDiagServerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="服务连接状态: 正在检测…"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDiagLanIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="本机局域网 IP: 获取中…"
            android:textColor="@color/theme_teal"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Node.js 运行时日志 (stdout/stderr 实时重定向):"
        android:textColor="#a0b0a8"
        android:textSize="11sp" />

    <!-- 实时日志输出区 -->
    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="6dp"
        android:background="#0a0f0d"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="暂无日志"
            android:textColor="#cce5dd"
            android:textSize="11sp" />
    </ScrollView>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShareLogs"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_logs"
            android:textColor="@color/theme_teal"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopyLogs"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复制日志"
            android:textColor="@color/theme_teal"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRefreshDiag"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="刷新"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCloseDiag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/theme_teal"
            android:text="关闭"
            android:textColor="@color/bg_dark"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
