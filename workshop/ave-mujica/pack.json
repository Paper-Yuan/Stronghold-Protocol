{
 "id": "ave-mujica",
 "name": "颂乐人偶",
 "version": "1.2.0",
 "author": "the Ave Mujica mod",
 "license": "GPL-3.0-or-later",
 "description": "颂乐人偶/Ave Mujica 核心盟约 mod：5 名成员干员（丰川祥子/三角初华/祐天寺若麦/八幡海铃/若叶睦）、成员特质（攻击/停顿/凋亡损伤/Fever 翻倍/25%效果共享）、5 层人数羁绊（刷新发放/休整期层数/资金/部署位/效果翻倍）。Fever 按 5 位成员「毋畏X」特质各自的增量逐条接线（数值取各自 chess 记录的 bb）；另有客户端面板在战场上给每名成员贴一个连音符样式的 Fever 积攒进度图标。与雷姆必拓 mod 兼容：若叶睦为双盟约成员。",
 "gameVersion": "0.2.6",
 "combat": true,
 "server": {
  "battle": {
   "module": "battle/main.mjs"
  },
  "meta": {
   "module": "meta/main.mjs",
