{
  "name": "明日方舟「卫戍协议：盟约」Codespaces 开服环境",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "卫戍协议游戏服务",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm ci && node tools/setup.mjs --no-local && node tools/fetch-bilingual-voices.mjs",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
